CREATE OR REPLACE FUNCTION mol_from_cdxml(cdxml cstring,keep_conformer bool default false, sanitize bool default true, remove_hs bool default true)
RETURNS mol
PARALLEL SAFE
AS 'MODULE_PATHNAME'
LANGUAGE C STRICT IMMUTABLE COST 100;

CREATE OR REPLACE FUNCTION qmol_from_cdxml(cdxml cstring,keep_conformer bool default false, merge_hs bool default true, strict_query_parsing bool default false)
RETURNS qmol
PARALLEL SAFE
AS 'MODULE_PATHNAME'
LANGUAGE C STRICT IMMUTABLE COST 100;
